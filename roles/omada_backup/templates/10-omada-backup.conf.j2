# {{ ansible_managed | default('Managed by Ansible') }} - deevnet.net omada_backup
#
# The Omada controller (host networking) sends its settings backup here over
# SFTP. Password logins are off for every other account and every other
# address; this account has no keys, no shell, and is locked between backups.
Match User {{ omada_backup_user }} Address 127.0.0.1,::1
    PasswordAuthentication yes
    ChrootDirectory {{ omada_backup_chroot }}
    ForceCommand internal-sftp
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTTY no
