# {{ ansible_managed }}
# Read by {{ tenant_egress_agent_unit }}.service. Root-only: it carries the
# token that reads the VRF list.
DEEVNET_API_URL={{ tenant_egress_agent_api_url }}
DEEVNET_AGENT_TOKEN={{ tenant_egress_agent_token }}
DEEVNET_TRANSIT_GATEWAY={{ tenant_egress_agent_gateway }}
DEEVNET_FRR_LOCAL={{ tenant_egress_agent_frr_local }}
{% if tenant_egress_agent_ca_src | length > 0 %}
DEEVNET_API_CACERT={{ tenant_egress_agent_ca_dest }}
{% endif %}
