# {{ ansible_managed }}
[Unit]
Description=Render tenant VRF default routes from the Deevnet API (ADR-0015 §7)
After=network-online.target pve-cluster.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ tenant_egress_agent_env }}
ExecStart={{ tenant_egress_agent_bin }}
# 75: the API answered 503, up but not ready. The agent changed nothing and the
# timer tries again; that is not a fault on the exit node, so the unit does not
# fail (INC-0007). An API that cannot be reached, refuses the token or answers
# anything else still fails it.
SuccessExitStatus=75
